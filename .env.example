# Configuration Template for Agentic Memory Simulation System
# Copy to .env and customize as needed. All values have safe defaults.
# NO SECRETS — safe to commit to version control.

# Profile cache TTL (seconds) — how long the engine caches user profiles.
# Default: 30 — a 60-360 second simulation run cannot observe a cache miss, or a
# profile containing facts ingested during the run, unless the TTL is shorter
# than the run. Set to 3600 (1 hour) in production.
PROFILE_CACHE_TTL_SECONDS=30

# Engine API base URL — where the memory engine FastAPI server listens.
# Default: http://localhost:8000 — local development.
ENGINE_API_BASE_URL=http://localhost:8000

# Audit database path — SQLite file storing all simulation events.
# Default: ./audit_log.db — relative to project root.
AUDIT_DB_PATH=./audit_log.db

# Scenario set size — how many test scenarios to generate per simulation run.
# Default: 50 — recommended for full suite (10+8+6+10+10+6 scenarios).
# For quick testing: 10-20.
SCENARIO_SET_SIZE=50

# Debug mode — enable verbose logging and extra diagnostics.
# Default: false (off)
# Set to true to see detailed logs from SimulationRunner, MonitoringService, etc.
DEBUG=false
