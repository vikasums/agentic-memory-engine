# Frontend Environment Configuration — React + Vite
# Copy to .env.local and customize as needed.
# Vite loads these at build time via import.meta.env.VITE_*

# Dashboard API base URL — the FastAPI monitoring server.
# Default: http://localhost:8000 — local development.
# This is where the dashboard fetches /simulate, /users, /audit, /metrics endpoints.
# For production: https://your-domain.com/api (adjust the path in vite.config.ts if needed)
VITE_API_BASE_URL=http://localhost:8000

# Optional: Enable verbose logging in the frontend during development.
# Default: false (off). Set to true to see API request/response logs in browser console.
# VITE_DEBUG=false
